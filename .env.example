# ============================================================
# Template Environment Variables — Simpul Sehat
# Salin ke server/.env dan client/.env saat menghubungkan Firebase
# ============================================================

# --- Server (server/.env) ---
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
AUTH_MODE=demo
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# --- Client (client/.env) ---
# VITE_API_URL=http://localhost:3001
# VITE_AUTH_MODE=demo
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
